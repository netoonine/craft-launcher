<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: packaging/macos/package.sh substitutes @VERSION@ (full, e.g. 0.4.1+m1),
     @SHORT_VERSION@ (numeric X.Y.Z) and @BUILD_SHA@.
     MANUCRAFT: this file is the fork's (name, bundle id ai.manucraft.launcher, icon, copyright,
     MANUCRAFTVersion); on an upstream sync keep ours and copy over any new keys.
     MANUCRAFT opens no documents, so there are no document or UT types. It is a normal Dock app
     that can also sit in the menu bar: LSUIElement must stay unset. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>MANUCRAFT</string>
  <key>CFBundleName</key>
  <string>MANUCRAFT</string>
  <key>CFBundleExecutable</key>
  <string>MANUCRAFT</string>
  <key>CFBundleIdentifier</key>
  <string>ai.manucraft.launcher</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <!-- The full version, with the +m<N> build: the launcher's self-update reads <Name>Version. -->
  <key>MANUCRAFTVersion</key>
  <string>@VERSION@</string>
  <key>MANUCRAFTBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>MANUCRAFT</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.utilities</string>
  <!-- Must match MACOSX_DEPLOYMENT_TARGET in package.sh. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <key>NSHumanReadableCopyright</key>
  <string>MANUCRAFT, based on ArtCraft Launcher. Copyright © 2026 ArtCraft Team and the ArtCraft Launcher contributors. MIT OR Apache-2.0.</string>
</dict>
</plist>
